{
  "expo": {
    "name": "GreenHeal",
    "slug": "greenheal",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#52B788"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.greenheal.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "GreenHeal needs your location to find plant nurseries near you."
      }
    },
    "android": {
      "package": "com.greenheal.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d1f17"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GreenHeal to access your camera to scan rooms and capture plant photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GreenHeal to access your photos to upload plant images."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow GreenHeal to use your location to find plant nurseries near you.",
          "locationWhenInUsePermission": "Allow GreenHeal to use your location to find plant nurseries near you."
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "OPENAI_API_KEY": "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",
      "PERENUAL_API_KEY": "sk-Prlb69aae80f17c4e15244",
      "STABILITY_API_KEY": "sk-Atj8Ocb47fjIBQNQ68CpZwnnnEh7HrSGm6cBlDyLFcvydjCa",
      "eas": {
        "projectId": "b1c87a32-dd36-4060-a9b0-0430f8dbc922"
      }
    },
    "owner": "marwawrf"
  }
}
